<T3DataStructure>
  <meta>
    <langDisable>1</langDisable>
  </meta>
  <sheets>
    <main>
      <ROOT>
        <sheetTitle>Einstellungen</sheetTitle>
        <type>array</type>
        <el>
          <settings.template>
            <label>Template</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <size>1</size>
            </config>
          </settings.template>
          <settings.limit>
            <label>LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.limit</label>
            <config>
              <type>input</type>
              <size>10</size>
              <eval>int</eval>
              <required>true</required>
              <range>
                <lower>1</lower>
              </range>
            </config>
          </settings.limit>
          <settings.platform>
            <label>LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.platformselect</label>
            <config>
              <type>select</type>
              <renderType>selectMultipleSideBySide</renderType>
              <itemsProcFunc>JAKOTA\ZernioConnector\Utility\PlatformItemsProcFunc->getItems</itemsProcFunc>
            </config>
          </settings.platform>
          <settings.respectSysLanguage>
            <label>LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.respectSysLanguage</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <items>
                <numIndex index="0">
                  <numIndex index="0">LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.translate</numIndex>
                  <numIndex index="1">1</numIndex>
                </numIndex>
                <numIndex index="1">
                  <numIndex index="0">LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.ignore</numIndex>
                  <numIndex index="1">0</numIndex>
                </numIndex>
              </items>
              <size>1</size>
            </config>
          </settings.respectSysLanguage>
        </el>
      </ROOT>
    </main>
  </sheets>
</T3DataStructure>

<T3DataStructure>
  <meta>
    <langDisable>1</langDisable>
  </meta>
  <sheets>
    <main>
      <ROOT>
        <sheetTitle>Einstellungen</sheetTitle>
        <type>array</type>
        <el>
          <settings.template>
            <label>Template</label>
            <config>
              <type>select</type>
              <renderType>selectSingle</renderType>
              <size>1</size>
            </config>
          </settings.template>
          <settings.limit>
            <label>LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.limit</label>
            <config>
              <type>input</type>
              <size>10</size>
              <max>2</max>
            </config>
          </settings.limit>
          <settings.platform>
            <label>LLL:EXT:zernio-connector/Resources/Private/Language/locallang.xlf:socialmedia.extension.platformselect</label>
            <config>
              <type>select</type>
              <renderType>selectMultipleSideBySide</renderType>
              <itemsProcFunc>JAKOTA\ZernioConnector\Utility\PlatformItemsProcFunc->getItems</itemsProcFunc>
            </config>
          </settings.platform>
        </el>
      </ROOT>
    </main>
  </sheets>
</T3DataStructure>
